---
layout: null
---
{%- comment -%} The documentation's search index: each page's title, headings and text, for docs.js.
  The pages' content is already rendered here, so headings are read from their h2 and h3. {%- endcomment -%}
{%- assign docs = site.pages | where: "layout", "docs" | where_exp: "p", "p.url contains '/jek/docs/jekray/'" -%}
[
{%- for p in docs -%}
  {%- comment -%} pages rendered before this one come as HTML, the rest still as Markdown {%- endcomment -%}
  {%- if p.content contains "</p>" -%}{%- assign html = p.content -%}{%- else -%}{%- assign html = p.content | markdownify -%}{%- endif -%}
  {%- assign heads = "" -%}
  {%- assign parts = html | replace: "<h3", "<h2" | split: "<h2" -%}
  {%- for part in parts offset: 1 -%}{%- assign t = part | split: "</h" | first | split: ">" | shift | join: ">" | strip_html | strip -%}{%- assign heads = heads | append: " · " | append: t -%}{%- endfor -%}
  {%- assign text = html | strip_html | replace: "\n", " " | normalize_whitespace | truncate: 6000, "" -%}
  {%- unless forloop.first %},{% endunless %}
  {"title": {{ p.title | jsonify }}, "url": {{ p.url | jsonify }}, "heads": {{ heads | remove_first: " · " | jsonify }}, "text": {{ text | jsonify }}}
{%- endfor %}
]
